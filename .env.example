# Ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
# True только когда сайт реально отдаётся по HTTPS
USE_HTTPS=False
SECURE_HSTS_SECONDS=0

POSTGRES_DB=disczone
POSTGRES_USER=disczone
POSTGRES_PASSWORD=change-me

# Почта (если EMAIL_HOST пустой, письма печатаются в лог)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DiscZone <no-reply@disczone.example>